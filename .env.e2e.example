# =============================================================================
# Variáveis dos testes E2E (Playwright). Ver e2e/README.md.
#
# 1. Copie este arquivo para .env.e2e (ele está no .gitignore — NUNCA commite).
# 2. Preencha a URL do UAT e as senhas recebidas por canal privado.
# 3. NUNCA aponte para produção.
# =============================================================================

# URL base do ambiente UAT (homologação), sem barra no final. OBRIGATÓRIA.
E2E_BASE_URL=https://uat.exemplo.com

# --- E-mails dos usuários de teste (um por papel). Já vêm com os valores padrão
# --- do seed de QA (prisma/seed-qa.ts); só altere se o UAT usar outros.
E2E_EMAIL_ADMIN=admin@genius.com
E2E_EMAIL_GERENTE_COMERCIAL=gerente@genius.com
E2E_EMAIL_VENDEDOR=joao@genius.com
E2E_EMAIL_VENDEDOR2=vendedor2@genius.com
E2E_EMAIL_VENDEDOR3=vendedor3@genius.com
E2E_EMAIL_GERENTE_PEDAGOGICO=gp@genius.com
E2E_EMAIL_PROFESSOR=carla@genius.com
E2E_EMAIL_PROFESSOR2=professor2@genius.com
E2E_EMAIL_FINANCEIRO=financeiro@genius.com
E2E_EMAIL_SECRETARIA=secretaria@genius.com

# --- Senhas (OBRIGATÓRIAS para os papéis usados nos testes). Peça ao gestor.
E2E_PASSWORD_ADMIN=
E2E_PASSWORD_GERENTE_COMERCIAL=
E2E_PASSWORD_VENDEDOR=
E2E_PASSWORD_VENDEDOR2=
E2E_PASSWORD_VENDEDOR3=
E2E_PASSWORD_GERENTE_PEDAGOGICO=
E2E_PASSWORD_PROFESSOR=
E2E_PASSWORD_PROFESSOR2=
E2E_PASSWORD_FINANCEIRO=
E2E_PASSWORD_SECRETARIA=
