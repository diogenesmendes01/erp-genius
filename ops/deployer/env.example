# URL vista de dentro da rede do compose, se for diferente da URL do host.
# MIGRATE_DATABASE_URL=
BACKUP_RETENTION_DAYS=14
DOCKER_NETWORK=
SMOKE_COOKIE=
SMOKE_PATH=/api/inbox/nao-lidas
