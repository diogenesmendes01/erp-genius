# Copiar para /etc/erp-deployer/env
# chmod 0600 e chown deployer:deployer. Nunca commitar valores reais.
# O script ignora PATH e qualquer chave fora da lista permitida.
# O UUID do Coolify é fixo (thpvwxk6figfp347ajznvzhl) e não entra neste arquivo.

COOLIFY_TOKEN=
COOLIFY_BASE_URL=http://127.0.0.1:8000
GHCR_TOKEN=
APP_BASE_URL=
