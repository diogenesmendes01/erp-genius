# =====================================================================
# Exemplo de DEV. Produção (VPS): deploy/env.production.example + docker-compose.prod.yml
# (doc 31); Coolify: docker-compose.coolify.yml + SETUP.md §Coolify. Dev e produção nunca
# compartilham banco (gap A5).
# [obrigatória] = o app não sobe/funciona sem ela · [opcional] = vazio desliga o recurso.
# Toda variável lida pelo app precisa estar repassada no `environment` do serviço `app` dos
# dois composes (travado por src/deploy/compose-env.test.ts).
# =====================================================================

# [obrigatória em produção com compose] Imagens no GHCR. Use o digest (não tag) para
# garantir imutabilidade. Obtenha os digests no job summary do workflow GitHub Actions.
# Em dev local, não precisa (usa npm run dev).
# APP_IMAGE="ghcr.io/diogenesmendes01/erp-genius@sha256:..."
# APP_MIGRATE_IMAGE="ghcr.io/diogenesmendes01/erp-genius/migrate@sha256:..."

# [obrigatória] Banco de dados PostgreSQL (local ou Neon/Supabase).
DATABASE_URL="postgresql://usuario:senha@localhost:5432/erp_genius?schema=public"

# [obrigatória] Auth.js — gere um segredo com: npx auth secret  (ou: openssl rand -base64 32)
AUTH_SECRET="troque-por-um-segredo-aleatorio"

# [obrigatória] URL base da aplicação.
NEXTAUTH_URL="http://localhost:3000"

# --- Drive institucional de gravações (somente servidor) -------------
# [opcional] Leitura (player). A conta de serviço precisa ter acesso de leitura apenas ao
# drive compartilhado. Chave privada em uma linha, com \n literais. Vazio = gravações indisponíveis.
GOOGLE_DRIVE_SERVICE_ACCOUNT_EMAIL=""
GOOGLE_DRIVE_SERVICE_ACCOUNT_PRIVATE_KEY=""
DRIVE_ORGANIZACAO_ID=""                 # ID do drive compartilhado autorizado

# [opcional] Publicação/fixação da revisão: credencial institucional separada, com escrita
# somente no Drive autorizado. O player continua usando a credencial de leitura.
GOOGLE_DRIVE_PUBLICACAO_SERVICE_ACCOUNT_EMAIL=""
GOOGLE_DRIVE_PUBLICACAO_SERVICE_ACCOUNT_PRIVATE_KEY=""

# ============================================================
# WhatsApp — canal bimotor (docs 26/30). TUDO opcional em dev:
# sem WHATSAPP_LIVE=1, o despachante SIMULA (nunca envia de verdade).
# ============================================================

# [opcional] Chave-mestra de envio real. Só em produção, só depois do piloto.
# WHATSAPP_LIVE="1"

# [obrigatória em produção] Segredo dos crons (header x-cron-secret): /api/whatsapp/cron,
# /api/whatsapp/despacho, /api/whatsapp/health, /api/portal-aluno/envios/cron,
# /api/agenda/avisos/cron e /api/financeiro/continuidade/cron. Sem ele, os crons respondem 503.
# A régua inclui vencimento de reservas particulares em lotes; requer agendador externo em dev.
CRON_SECRET="troque-por-um-segredo-aleatorio"

# [obrigatória em produção] Motor WhatsApp (whatsapp-web-baileys em modo serviço), só na rede
# interna. Em dev, aponte para o motor local; nos composes de produção é http://motor:4317.
MOTOR_URL="http://127.0.0.1:4317"
MOTOR_API_KEY=""            # mínimo 32 caracteres: openssl rand -hex 32 (Bearer ERP -> motor)
MOTOR_WEBHOOK_SECRET=""     # mínimo 32 caracteres; HMAC do webhook motor -> ERP (nunca reaproveite CRON_SECRET)

# [Coolify apenas] Postgres dedicado do motor + chave mestra do cofre. Em dev local e em
# docker-compose.prod.yml, o motor usa PGlite embarcado (não precisa dessas variáveis).
# MOTOR_DATABASE_URL=""     # postgresql://user:pass@hostname:5432/motor (hostname é o UUID do Coolify)
# MOTOR_MASTER_KEY=""       # openssl rand -hex 32 (mínimo 32 caracteres)

# --- E-mail institucional (Resend) ----------------------------------
# [opcional] Usado pelo portal do aluno e pelos avisos de agenda por e-mail. Vazio = sem e-mail.
RESEND_API_KEY=""
EMAIL_INSTITUCIONAL_REMETENTE=""        # remetente de domínio verificado no Resend

# [opcional] E-mail de acesso ao portal: desligado ("false") até homologação operacional.
# Só "true" liga. Processado por POST /api/portal-aluno/envios/cron (x-cron-secret; nos composes de
# produção, serviço cron-portal-envios a cada 60 s; em dev, agendador externo).
EMAIL_PORTAL_ENVIO_ENABLED="false"
# [obrigatória se EMAIL_PORTAL_ENVIO_ENABLED=true] Origem HTTPS pública, sem caminho/query;
# base dos links dos e-mails (não usar a URL recebida da requisição).
PORTAL_ALUNO_URL_PUBLICA=""

# --- Habilitações operacionais (só "true" liga) ---------------------
# [opcional] Emissão mensal recorrente (POST /api/financeiro/continuidade/cron — sem agendador nos
# composes: ao ligar, configure um externo).
CONTINUIDADE_MENSAL_EMISSAO_ENABLED="false"
# [opcional] Avisos de alterações de agenda: manter desligados até homologação operacional.
# POST /api/agenda/avisos/cron exige o mesmo x-cron-secret do agendador (nos composes de produção,
# serviço cron-avisos-agenda a cada 5 min); o despachante geral
# do WhatsApp também retém esses avisos enquanto desligado.
# A configuração não agenda execuções nem autoriza destinatários por si só.
COMUNICACOES_AGENDA_ENVIO_ENABLED="false"
# [opcional] Avisos de quantidade de aulas (Q38) só alcançam provedores com "true".
COMUNICACOES_AGENDA_QUANTIDADE_ENVIO_ENABLED="false"

# --- IA (Aria) -------------------------------------------------------
# [opcional] Sem a chave, a IA roda um provedor local determinístico ("simulado").
# Com a chave, usa a API da Anthropic. Os modelos ficam em Configurações › CRM › IA.
ANTHROPIC_API_KEY=""

# --- Pagamento -------------------------------------------------------
# [opcional] "1" só em dev/demo (página de pagamento simulada); nunca em produção.
PAGAMENTO_SIMULADO=""

# --- Assinatura eletrônica (Q155) -------------------------------------
# [opcional] Vazio = sem integração (registro manual do documento assinado).
# "simulado" = driver SIMULADO: envio e cancelamento funcionam ponta a ponta sem
# fornecedor; nada é enviado ao cliente, processos ficam SIMULADO/SANDBOX e as
# telas avisam. Só em dev/UAT/demo. Qualquer outro valor falha (não há driver real).
ASSINATURA_DRIVER=""
