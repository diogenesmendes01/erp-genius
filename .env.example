# Banco de dados PostgreSQL (local ou Neon/Supabase)
DATABASE_URL="postgresql://usuario:senha@localhost:5432/erp_genius?schema=public"

# Auth.js — gere um segredo com: npx auth secret  (ou: openssl rand -base64 32)
AUTH_SECRET="troque-por-um-segredo-aleatorio"

# URL base da aplicação
NEXTAUTH_URL="http://localhost:3000"

# Drive institucional de gravações — somente variáveis de servidor.
# A conta de serviço precisa ter acesso de leitura apenas ao drive compartilhado.
GOOGLE_DRIVE_SERVICE_ACCOUNT_EMAIL=""
GOOGLE_DRIVE_SERVICE_ACCOUNT_PRIVATE_KEY=""
DRIVE_ORGANIZACAO_ID=""

# Publicação/fixação da revisão: credencial institucional separada, com escrita
# somente no Drive autorizado. O player continua usando a credencial de leitura.
GOOGLE_DRIVE_PUBLICACAO_SERVICE_ACCOUNT_EMAIL=""
GOOGLE_DRIVE_PUBLICACAO_SERVICE_ACCOUNT_PRIVATE_KEY=""

# ============================================================
# WhatsApp — canal bimotor (docs 26/30). TUDO opcional em dev:
# sem WHATSAPP_LIVE=1, o despachante SIMULA (nunca envia de verdade).
# ============================================================

# Chave-mestra de envio real. Só em produção, só depois do piloto.
# WHATSAPP_LIVE="1"

# Cron operacional e régua (POST /api/whatsapp/cron com header x-cron-secret).
# Inclui vencimento de reservas particulares em lotes; requer agendador externo.
CRON_SECRET="troque-por-um-segredo-aleatorio"

# Motor WhatsApp (whatsapp-web-baileys em modo serviço), só na rede interna.
MOTOR_URL="http://127.0.0.1:4317"
MOTOR_API_KEY=""            # mínimo 32 caracteres: openssl rand -hex 32
MOTOR_WEBHOOK_SECRET=""     # mínimo 32 caracteres; assina o webhook motor -> ERP (nunca reaproveite CRON_SECRET)

# Produção (VPS): use deploy/env.production.example + docker-compose.prod.yml (doc 31).
# Este arquivo é o exemplo de DEV — dev e produção nunca compartilham banco (gap A5).

# Emissão mensal recorrente: desligada até ativação operacional explícita.
# CONTINUIDADE_MENSAL_EMISSAO_ENABLED="true"

# E-mail de acesso ao portal (Resend): desligado até homologação operacional.
# POST /api/portal-aluno/envios/cron, usando x-cron-secret; agendador externo.
EMAIL_PORTAL_ENVIO_ENABLED="false"
RESEND_API_KEY=""
EMAIL_INSTITUCIONAL_REMETENTE=""
# Origem HTTPS pública, sem caminho/query; não usar a URL recebida da requisição.
PORTAL_ALUNO_URL_PUBLICA=""

# Avisos de alterações de agenda: manter desligados até homologação operacional.
# POST /api/agenda/avisos/cron exige o mesmo x-cron-secret do agendador.
# A configuração não agenda execuções nem autoriza destinatários por si só.
COMUNICACOES_AGENDA_ENVIO_ENABLED="false"

# --- C3: IA copiloto (só-leitura — doc 27) ---
# Sem a chave, o copiloto roda uma heurística local determinística ("simulado").
# Com a chave, usa a API da Anthropic (modelo em IA_MODELO; default claude-sonnet-5).
ANTHROPIC_API_KEY=""
IA_MODELO=""

# --- Motor WhatsApp (Fase 4) ---
# URL interna do motor (rede do compose; o motor não publica porta).
MOTOR_URL="http://motor:4317"
# Chave ERP -> motor (Bearer). Mínimo 32 caracteres. Ex.: openssl rand -hex 32
MOTOR_API_KEY=""
# Segredo do HMAC dos webhooks motor -> ERP. Mínimo 32 caracteres. Nunca reutilizar CRON_SECRET.
MOTOR_WEBHOOK_SECRET=""
