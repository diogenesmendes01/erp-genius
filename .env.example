# Banco de dados PostgreSQL (local ou Neon/Supabase)
DATABASE_URL="postgresql://usuario:senha@localhost:5432/erp_genius?schema=public"

# Auth.js — gere um segredo com: npx auth secret  (ou: openssl rand -base64 32)
AUTH_SECRET="troque-por-um-segredo-aleatorio"

# URL base da aplicação
NEXTAUTH_URL="http://localhost:3000"

# ============================================================
# WhatsApp — canal bimotor (docs 26/30). TUDO opcional em dev:
# sem WHATSAPP_LIVE=1, o despachante SIMULA (nunca envia de verdade).
# ============================================================

# Chave-mestra de envio real. Só em produção, só depois do piloto.
# WHATSAPP_LIVE="1"

# Cron da régua (POST /api/whatsapp/cron com header x-cron-secret).
CRON_SECRET="troque-por-um-segredo-aleatorio"

# Driver oficial — Meta Cloud API (número de cobrança).
META_WA_TOKEN=""            # token permanente do system user da WABA
META_WA_APP_SECRET=""       # valida X-Hub-Signature-256 do webhook (obrigatório p/ webhook)
META_WA_VERIFY_TOKEN=""     # handshake GET do webhook (você escolhe o valor)
META_WA_WABA_ID=""          # id da WhatsApp Business Account (mapeador/editor de templates — E4)
# META_WA_GRAPH_URL="https://graph.facebook.com/v21.0"

# Driver Baileys — Evolution API self-hosted (número de vendas).
EVOLUTION_URL=""            # ex.: http://127.0.0.1:8080 (nunca exposta à internet)
EVOLUTION_APIKEY=""         # apikey da instância Evolution
EVOLUTION_WEBHOOK_TOKEN=""  # header `apikey` que a Evolution manda no webhook p/ cá
# URL pública que a Evolution usa para entregar webhooks aqui (default: NEXTAUTH_URL).
# Em dev com túnel (ngrok etc.), aponte para o túnel:
# EVOLUTION_WEBHOOK_PUBLIC_URL="https://seu-tunel.exemplo.com"

# Produção (VPS): use deploy/env.production.example + docker-compose.prod.yml (doc 31).
# Este arquivo é o exemplo de DEV — dev e produção nunca compartilham banco (gap A5).

# --- C3: IA copiloto (só-leitura — doc 27) ---
# Sem a chave, o copiloto roda uma heurística local determinística ("simulado").
# Com a chave, usa a API da Anthropic (modelo em IA_MODELO; default claude-sonnet-5).
ANTHROPIC_API_KEY=""
IA_MODELO=""
