# =====================================================================
# Produção (VPS) — copie para .env NA RAIZ do repo clonado na VPS:
#   cp deploy/env.production.example .env
# O docker-compose.prod.yml lê estas variáveis. NUNCA commitar o .env real.
# Segredos: gere com `openssl rand -hex 32` — HEX é URL-safe. NÃO use -base64 para a
# senha do Postgres: ela entra crua em connection URLs e `/` `+` `=` as quebram
# (o Prisma exige percent-encoding de caracteres especiais).
# =====================================================================

# --- Infra -----------------------------------------------------------
DOMINIO_APP="erp.exemplo.com"        # DNS já apontando p/ a VPS (Caddy emite o TLS sozinho)
POSTGRES_USER="erp"
POSTGRES_PASSWORD=""                 # openssl rand -hex 32 (URL-safe — vira parte da DATABASE_URL)

# --- App -------------------------------------------------------------
AUTH_SECRET=""                       # openssl rand -hex 32
CRON_SECRET=""                       # protege /api/whatsapp/cron e /health

# --- WhatsApp: chave-mestra do envio real ------------------------------
# VAZIO = shadow global (tudo SIMULADA). Só colocar "1" no go-live (doc 31 §rollout).
WHATSAPP_LIVE=""

# --- Motor WhatsApp (whatsapp-web-baileys, modo serviço) --------------
MOTOR_IMAGE=""                       # imagem publicada do motor (obrigatória)
MOTOR_API_KEY=""                     # openssl rand -hex 32 (mínimo 32 caracteres; ERP -> motor)
MOTOR_WEBHOOK_SECRET=""              # openssl rand -hex 32 (mínimo 32 caracteres; HMAC do webhook motor -> ERP)

# --- Fases 1-3 (ago/2026) ---
ANTHROPIC_API_KEY=""                 # C3: copiloto IA (vazio = heuristica local "simulado")
IA_MODELO=""                         # modelo da API Anthropic (default claude-sonnet-5)
PAGAMENTO_SIMULADO=""                # "1" SO em dev/demo — habilita o pagar da pagina /pagar/[token]
