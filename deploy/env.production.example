# =====================================================================
# Produção (VPS) — copie para .env NA RAIZ do repo clonado na VPS:
#   cp deploy/env.production.example .env
# O docker-compose.prod.yml lê estas variáveis. NUNCA commitar o .env real.
# Segredos: gere com `openssl rand -hex 32` — HEX é URL-safe. NÃO use -base64 para a
# senha do Postgres: ela entra crua em connection URLs e `/` `+` `=` as quebram
# (o Prisma exige percent-encoding de caracteres especiais).
# OBRIGATÓRIAS (o compose recusa subir sem elas): APP_IMAGE, APP_MIGRATE_IMAGE, DOMINIO_APP, POSTGRES_USER,
# POSTGRES_PASSWORD, AUTH_SECRET, CRON_SECRET, MOTOR_IMAGE, MOTOR_API_KEY, MOTOR_WEBHOOK_SECRET. As demais são opcionais.
# Toda variável lida pelo app é repassada no `environment` do serviço `app` (src/deploy/compose-env.test.ts).
# =====================================================================

# --- Infra -----------------------------------------------------------
DOMINIO_APP="erp.exemplo.com"        # DNS já apontando p/ a VPS (Caddy emite o TLS sozinho)
POSTGRES_USER="erp"
POSTGRES_PASSWORD=""                 # openssl rand -hex 32 (URL-safe — vira parte da DATABASE_URL)

# --- Imagens Docker (GHCR) --------------------------------------------
# Imagens publicadas no GHCR. Use o digest (não tag) para garantir imutabilidade.
# Obtenha os digests no job summary do workflow "Build e publicação de imagem" no GitHub Actions.
APP_IMAGE=""                         # imagem do app (runner): ghcr.io/diogenesmendes01/erp-genius@sha256:...
APP_MIGRATE_IMAGE=""                 # imagem do migrate (builder): ghcr.io/diogenesmendes01/erp-genius/migrate@sha256:...

# --- App -------------------------------------------------------------
AUTH_SECRET=""                       # openssl rand -hex 32
CRON_SECRET=""                       # protege todos os crons (header x-cron-secret) e /api/whatsapp/health

# --- WhatsApp: chave-mestra do envio real ------------------------------
# VAZIO = shadow global (tudo SIMULADA). Só colocar "1" no go-live (doc 31 §rollout).
WHATSAPP_LIVE=""

# --- Motor WhatsApp (whatsapp-web-baileys, modo serviço) --------------
MOTOR_IMAGE=""                       # imagem publicada do motor (obrigatória)
MOTOR_API_KEY=""                     # openssl rand -hex 32 (mínimo 32 caracteres; ERP -> motor)
MOTOR_WEBHOOK_SECRET=""              # openssl rand -hex 32 (mínimo 32 caracteres; HMAC do webhook motor -> ERP)

# --- Fases 1-3 (ago/2026) ---
# Aria (Fase 5, ADR-F5-01). Vazio = provedor local deterministico ("simulado"), nada chama a rede.
# Com a chave, a Aria usa a API da Anthropic e, quando ATIVA, pode responder clientes.
# Os modelos ficam em Configuracoes > CRM > IA (nao ha variavel de modelo).
ANTHROPIC_API_KEY=""
PAGAMENTO_SIMULADO=""                # "1" SO em dev/demo — habilita o pagar da pagina /pagar/[token]
ASSINATURA_DRIVER=""                 # vazio = registro manual do assinado. "simulado" SO em UAT/demo (nada e enviado ao cliente; processos SIMULADO/SANDBOX). Sem driver real (Q155)

# --- E-mail institucional (Resend) — opcional -------------------------
# Usado pelo portal do aluno e pelos avisos de agenda por e-mail. Vazio = nenhum e-mail sai.
RESEND_API_KEY=""                    # chave da API Resend
EMAIL_INSTITUCIONAL_REMETENTE=""     # remetente de domínio verificado no Resend (ex.: nao-responda@exemplo.com)
# Portal do aluno: e-mails de acesso (convite/recuperação/troca). Só "true" liga.
EMAIL_PORTAL_ENVIO_ENABLED="false"
# Obrigatória se EMAIL_PORTAL_ENVIO_ENABLED=true: origem HTTPS pública, sem caminho
# (ex.: https://erp.exemplo.com) — base dos links dos e-mails.
PORTAL_ALUNO_URL_PUBLICA=""

# --- Google Drive de gravações — opcional ------------------------------
# Leitura (player). Chave privada em UMA linha, com \n literais (o app converte).
GOOGLE_DRIVE_SERVICE_ACCOUNT_EMAIL=""
GOOGLE_DRIVE_SERVICE_ACCOUNT_PRIVATE_KEY=""
DRIVE_ORGANIZACAO_ID=""              # ID do drive compartilhado autorizado
# Publicação/fixação de revisão: credencial SEPARADA, com escrita só no Drive autorizado.
GOOGLE_DRIVE_PUBLICACAO_SERVICE_ACCOUNT_EMAIL=""
GOOGLE_DRIVE_PUBLICACAO_SERVICE_ACCOUNT_PRIVATE_KEY=""

# --- Habilitações operacionais — opcionais (só "true" liga) -----------
CONTINUIDADE_MENSAL_EMISSAO_ENABLED="false"           # emissão mensal recorrente
COMUNICACOES_AGENDA_ENVIO_ENABLED="false"             # avisos de alteração de agenda
COMUNICACOES_AGENDA_QUANTIDADE_ENVIO_ENABLED="false"  # avisos de quantidade de aulas (Q38)
# Os composes já agendam /api/portal-aluno/envios/cron (60 s) e /api/agenda/avisos/cron (5 min);
# com a flag desligada as rotas só respondem {executou:false}. ATENÇÃO: /api/financeiro/continuidade/cron
# NÃO é agendado — ao ligar a emissão, configure um agendador externo (POST, header x-cron-secret).
