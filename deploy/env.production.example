# =====================================================================
# Produção (VPS) — copie para .env NA RAIZ do repo clonado na VPS:
#   cp deploy/env.production.example .env
# O docker-compose.prod.yml lê estas variáveis. NUNCA commitar o .env real.
# Segredos: gere com `openssl rand -base64 32` (um valor diferente para cada).
# =====================================================================

# --- Infra -----------------------------------------------------------
DOMINIO_APP="erp.exemplo.com"        # DNS já apontando p/ a VPS (Caddy emite o TLS sozinho)
POSTGRES_USER="erp"
POSTGRES_PASSWORD=""                 # openssl rand -base64 32

# --- App -------------------------------------------------------------
AUTH_SECRET=""                       # openssl rand -base64 32
CRON_SECRET=""                       # protege /api/whatsapp/cron e /health

# --- WhatsApp: chave-mestra do envio real ------------------------------
# VAZIO = shadow global (tudo SIMULADA). Só colocar "1" no go-live (doc 31 §rollout).
WHATSAPP_LIVE=""

# --- Driver oficial (Meta Cloud API — número de cobrança) -------------
META_WA_TOKEN=""                     # token permanente do system user da WABA
META_WA_APP_SECRET=""                # valida X-Hub-Signature-256 (obrigatório p/ webhook)
META_WA_VERIFY_TOKEN=""              # você escolhe; usado no handshake GET do webhook
META_WA_WABA_ID=""                   # id da WhatsApp Business Account (templates)

# --- Driver Baileys (Evolution API — número de vendas) ----------------
EVOLUTION_APIKEY=""                  # openssl rand -base64 32 (auth da API da Evolution)
EVOLUTION_WEBHOOK_TOKEN=""           # openssl rand -base64 32 (header apikey do webhook p/ cá)
