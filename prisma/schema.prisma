  id String @id @default(cuid())
  rascunhoId String @unique
  rascunho RascunhoRecomposicaoCobertura @relation(fields: [rascunhoId], references: [id], onDelete: Restrict)
  decisorId String
  decisor Usuario @relation(fields: [decisorId], references: [id], onDelete: Restrict)
  aprovada Boolean
  motivo String
  decididaEm DateTime @default(now())
}

model AplicacaoRecomposicaoCobertura {
  id String @id @default(cuid())
  decisaoId String @unique
  decisao DecisaoRecomposicaoCobertura @relation(fields: [decisaoId], references: [id], onDelete: Restrict)
  executorId String
  executor Usuario @relation(fields: [executorId], references: [id], onDelete: Restrict)
  aplicadaEm DateTime @default(now())
  dias DiaProgramadoRecomposicao[]
}

model DiaProgramadoRecomposicao {
  conferencias ConferenciaCumprimentoRecomposicao[]
  id String @id @default(cuid())
  aplicacaoId String
  aplicacao AplicacaoRecomposicaoCobertura @relation(fields: [aplicacaoId], references: [id], onDelete: Restrict)
  direitoId String @unique
  direito DiaCompensacaoCobertura @relation(fields: [direitoId], references: [id], onDelete: Restrict)
  dataCobertura DateTime @db.Date
}

model ConferenciaCumprimentoRecomposicao {
  id String @id @default(cuid())
  programacaoId String
  programacao DiaProgramadoRecomposicao @relation(fields: [programacaoId], references: [id], onDelete: Restrict)
  preparadorId String
  preparador Usuario @relation("PreparadorCumprimento", fields: [preparadorId], references: [id], onDelete: Restrict)
  decisorId String?
  decisor Usuario? @relation("DecisorCumprimento", fields: [decisorId], references: [id], onDelete: Restrict)
  status StatusAprovacao @default(PENDENTE)
  evidencia String
  motivo String
  motivoDecisao String?
  decididaEm DateTime?
  chaveIdempotencia String
  entradaHash String
  snapshot Json
  criadoEm DateTime @default(now())
  @@unique([preparadorId, chaveIdempotencia], map: "cumprimento_recomposicao_chave_key")
  @@index([programacaoId, status])
}

model CompensacaoCoberturaMatricula {
  documentoOrigemId String?
  documentoOrigem Documento? @relation(fields: [documentoOrigemId], references: [id], onDelete: Restrict)
  chaveIdempotencia String?
  entradaHash String?
  @@unique([preparadorId, chaveIdempotencia], map: "compensacao_preparador_chave_key")
  id String @id @default(cuid())
  matriculaId String
  matricula Matricula @relation(fields: [matriculaId], references: [id], onDelete: Restrict)
  cobrancaOrigemId String
  cobrancaOrigem Cobranca @relation(fields: [cobrancaOrigemId, matriculaId], references: [id, matriculaId], onDelete: Restrict)
  preparadorId String
  preparador Usuario @relation("PreparadorCompensacao", fields: [preparadorId], references: [id], onDelete: Restrict)
  decisorId String?
  decisor Usuario? @relation("DecisorCompensacao", fields: [decisorId], references: [id], onDelete: Restrict)
  status StatusAprovacao @default(PENDENTE)
  motivo String
  evidenciaCondicoes String
  diasPropostos Json
  coberturaOriginalInicio DateTime @db.Date
  coberturaOriginalFim DateTime @db.Date
  valorCoberturaOriginal Decimal @db.Decimal(12, 2)
  moeda String
  cobrancaVersao Int
  motivoDecisao String?
  decididaEm DateTime?
  criadoEm DateTime @default(now())
  dias DiaCompensacaoCobertura[]
  @@unique([id, matriculaId], map: "compensacao_id_matricula_key")
  @@index([matriculaId, status])
}

enum EstadoDiaCompensacao {
  PENDENTE
  RECOMPOSTO
  LIQUIDADO_FINANCEIRAMENTE
}

model DiaCompensacaoCobertura {
