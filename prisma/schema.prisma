// ERP Genius — schema modelado em EVENTOS + estado (não em telas).
// Espinha dorsal: tabela `Evento` (audit/event log append-only).
// Regra: Evento = auditoria; tabelas tipadas (ex.: AjusteFinanceiro) = relatório.
// Evolução futura (NÃO V0): Papel enum[] -> tabela UsuarioPapel (escopo por país);
//   unificar Lead/Aluno/Responsavel sob uma entidade Pessoa/Contato.
// Ver docs/02-arquitetura.md e docs/09-fase0-telas.md.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ACESSO
// ============================================================

enum Papel {
  ADMINISTRADOR
  GERENTE_COMERCIAL
  VENDEDOR
  GERENTE_PEDAGOGICO
  PROFESSOR
  FINANCEIRO
  SECRETARIA_ACADEMICA
}

model Usuario {
  id                String    @id @default(cuid())
  nome              String
  email             String    @unique
  senhaHash         String
  ativo             Boolean   @default(true)
  papeis            Papel[] // multi-papel. V2: migrar p/ tabela UsuarioPapel (permissões granulares / por país)
  limiteDescontoPct Decimal?  @db.Decimal(5, 2) // null = sem limite (Admin)
  // dados pessoais (ex.: professores importados — doc 23). Opcionais.
  telefoneE164      String?
  documento         String?
  nascimento        DateTime?
  genero            Genero?
  ultimoAcesso      DateTime?
  criadoEm          DateTime  @default(now())

  leads             Lead[]              @relation("VendedorLeads")
  experimentais     Lead[]              @relation("ProfessorExperimentais") // experimentais (leads) sob responsabilidade do professor (Issue #13)
  turmas            Turma[]             @relation("ProfessorTurmas")
  comissoes         Comissao[]
  eventos           Evento[]            @relation("AutorEventos")
  aprovacoes        Aprovacao[]         @relation("SolicitanteAprovacoes")
  aprovadasPor      Aprovacao[]         @relation("AprovadorAprovacoes")
  ajustes           AjusteFinanceiro[]  @relation("AutorAjustes")
  movimentacoes     MovimentacaoAluno[] @relation("AutorMovimentacoes")
  numerosWhatsApp   NumeroWhatsApp[]    @relation("DonoNumerosWhatsApp")
  mensagensWhatsApp MensagemWhatsApp[]  @relation("AutorMensagensWhatsApp")
  intencoesWhatsApp IntencaoMensagem[]  @relation("AutorIntencoesWhatsApp")
  sugestoesIADecididas SugestaoIA[]     @relation("DecisorSugestoesIA")
}

// ============================================================
// PAÍS / MERCADO (espinha dorsal do multi-país)
// ============================================================

enum StatusPais {
  RASCUNHO
  ATIVO
  PAUSADO
  ENCERRADO
}

model Pais {
  id         String     @id @default(cuid())
  nome       String
  codigoISO  String     @unique
  moedaLocal String // ex.: CRC, USD, MXN
  ddi        String // ex.: +506
  fuso       String     @default("America/Sao_Paulo")
  idioma     String     @default("es")
  status     StatusPais @default(RASCUNHO)
  criadoEm   DateTime   @default(now())

  tiposDocumento TipoDocumento[]
  produtosPais   ProdutoPais[]
  precos         PrecoReferencia[]
  alunos         Aluno[]
  leads          Lead[]
  matriculas     Matricula[]
}

model TipoDocumento {
  id        String  @id @default(cuid())
  paisId    String
  pais      Pais    @relation(fields: [paisId], references: [id])
  nome      String // CPF, DNI, CURP, Cédula, Passaporte...
  validador String // nome do validador: cpf, curp, cedula_cr, passaporte...
  alunos    Aluno[] // alunos que escolheram este tipo de documento (doc 04)
}

// ============================================================
// CATÁLOGO
// ============================================================

enum Segmento {
  ADULTO
  KIDS
  TEENS
  EMPRESA
}

model Idioma {
  id       String    @id @default(cuid())
  nome     String // Português, Inglês...
  ativo    Boolean   @default(true)
  niveis   Nivel[]
  produtos Produto[]
}

model Modalidade {
  id              String   @id @default(cuid())
  nome            String // Regular, Semi-intensiva, Intensiva, Super-intensiva, Particular, Kids Regular...
  segmento        Segmento @default(ADULTO)
  frequencia      String // 1x/semana, 2x/semana...
  horasAula       Float    @default(2)
  duracaoPorNivel String // "3 meses", "1 mês"...
  aulasPorNivel   Int? // 12, 16, 18, 20...
  minimoAbrir     Int      @default(1)

  produtos Produto[]
  turmas   Turma[]
  precos   PrecoReferencia[]
}

model Nivel {
  id       String @id @default(cuid())
  idiomaId String
  idioma   Idioma @relation(fields: [idiomaId], references: [id])
  codigo   String // Pré A1, A1, A2, B1, B2, C1, C2
  ordem    Int

  turmas Turma[]
}

// Produto vendável = idioma + modalidade
model Produto {
  id           String            @id @default(cuid())
  idiomaId     String
  idioma       Idioma            @relation(fields: [idiomaId], references: [id])
  modalidadeId String
  modalidade   Modalidade        @relation(fields: [modalidadeId], references: [id])
  produtosPais ProdutoPais[]
  precos       PrecoReferencia[]
  matriculas   Matricula[]
}

enum TipoCobranca {
  MATRICULA // taxa de matrícula (negociável)
  MENSALIDADE // Regular/Intensivo/Kids… (negociável)
  HORA_PARTICULAR // aulas particulares (cobrança por hora)
  MATERIAL // material didático
  CERTIFICADO // certificado profissional — fixo, só Costa Rica (doc 04)
}

// Disponibilidade do produto por país (catálogo global → país habilita subconjunto).
// O PREÇO mora em PrecoReferencia (tabela tipada), não aqui.
model ProdutoPais {
  id        String  @id @default(cuid())
  produtoId String
  produto   Produto @relation(fields: [produtoId], references: [id])
  paisId    String
  pais      Pais    @relation(fields: [paisId], references: [id])
  moeda     String
  oferecido Boolean @default(true)

  @@unique([produtoId, paisId])
}

// PREÇO TIPADO (decisão P5, doc 15): País + Produto + Modalidade + TipoCobrança = preço.
// modalidadeId é explícito (apesar de derivável de Produto) p/ relatório/seed simples.
// moeda gravada também aqui (vem do país) para fidelidade histórica.
model PrecoReferencia {
  id           String       @id @default(cuid())
  paisId       String
  pais         Pais         @relation(fields: [paisId], references: [id])
  produtoId    String
  produto      Produto      @relation(fields: [produtoId], references: [id])
  modalidadeId String
  modalidade   Modalidade   @relation(fields: [modalidadeId], references: [id])
  tipoCobranca TipoCobranca
  valor        Decimal      @db.Decimal(12, 2)
  moeda        String
  ativo        Boolean      @default(true)
  versaoEstudo String?
  vigenteDesde DateTime     @default(now())
  criadoEm     DateTime     @default(now())
  // Proteção lógica: no máximo UM preço ATIVO por combinação
  // (país + produto + modalidade + tipo de cobrança). Como Prisma não suporta
  // índice único parcial, ele é criado por SQL na migration
  // 20260622120000_preco_ativo_unico (partial unique index WHERE ativo).

  // Integridade (issue #1): no máx. UM preço ATIVO por país+produto+modalidade+tipoCobrança.
  // Índice único PARCIAL (só ativo=true) — mora na migration `integridade_alocacao_preco`
  // (UNIQUE ... WHERE "ativo"). O histórico desativado (supersede) permanece livre.
  @@index([paisId, produtoId, modalidadeId, tipoCobranca])
  @@index([ativo])
}

// ============================================================
// TURMAS
// ============================================================

enum StatusTurma {
  PLANEJADA
  ABERTA
  EM_ANDAMENTO
  CONCLUIDA
}

model Turma {
  id            String      @id @default(cuid())
  codigo        String?     @unique // T-000001
  nome          String? // nome livre da turma (a escola batiza como quiser: "Salvador", "Particular Ronny"...)
  modalidadeId  String
  modalidade    Modalidade  @relation(fields: [modalidadeId], references: [id])
  nivelId       String
  nivel         Nivel       @relation(fields: [nivelId], references: [id])
  professorId   String?
  professor     Usuario?    @relation("ProfessorTurmas", fields: [professorId], references: [id])
  online        Boolean     @default(true) // online (hoje) × presencial (futuro) — não há "sede" física
  // Agenda da turma (calendário real — doc 06): dias da semana + horário. O nº de dias
  // deve casar com a frequência da modalidade (1x/2x/3x/5x por semana). `diasHorario` é o
  // rótulo DERIVADO (ex.: "Seg, Qua, Sex · 19:00") mantido para exibição/compat.
  diasSemana    Int[]       @default([]) // 0=Dom · 1=Seg … 6=Sáb
  horarioInicio String? // "HH:MM" — início da aula
  horarioFim    String? // "HH:MM" — fim da aula
  diasHorario   String? // rótulo derivado (ex.: "Seg, Qua, Sex · 19:00–21:00"); null em turmas antigas
  dataInicio    DateTime?
  dataFim       DateTime?
  cronograma    String?
  capacidade    Int         @default(16)
  status        StatusTurma @default(PLANEJADA)
  rolling       Boolean     @default(false) // Pré A1 (entrada contínua) — A1 herda janela maior
  criadoEm      DateTime    @default(now())

  alocacoes AlocacaoTurma[]
}

// ============================================================
// ALUNOS
// ============================================================

enum StatusAluno {
  ATIVO
  PAUSADO
  ENCERRADO
}

// Gênero (doc 09 §Identificação): lista curta — Masculino · Feminino · Prefiro não informar.
// (V0 tinha OUTRO; removido na migration `aluno_cadastro_completo`, OUTRO→NAO_INFORMADO.)
enum Genero {
  MASCULINO
  FEMININO
  NAO_INFORMADO // rótulo na UI: "Prefiro não informar"
}

// Escolaridade do aluno (doc 09 §Acadêmico). Lista fechada, ordem crescente.
enum Escolaridade {
  FUNDAMENTAL_INCOMPLETO
  FUNDAMENTAL_COMPLETO
  MEDIO_INCOMPLETO
  MEDIO_COMPLETO
  TECNICO
  SUPERIOR_INCOMPLETO
  SUPERIOR_COMPLETO
  POS_GRADUACAO
  MESTRADO
  DOUTORADO
}

// Cadastro de pessoa guiado pelo país (doc 04 §espinha dorsal). O `paisId` é o país-base
// (mercado) que comanda tipos de documento, DDI do telefone e moeda da matrícula.
// Nacionalidade / 2ª nacionalidade / país de residência / país emissor são ISO 3166
// (qualquer país — ver `lib/paises-iso.ts`), pois não são mercados da Genius.
model Aluno {
  id     String  @id @default(cuid())
  codigo String? @unique // A-000001

  // Identificação (doc 09 §Identificação). `nome` foi dividido em primeiroNome+sobrenome
  // na migration `aluno_cadastro_completo` (backfill: split no 1º espaço).
  primeiroNome  String
  sobrenome     String?
  nomePreferido String?
  nascimento    DateTime?
  genero        Genero?

  // Documentação — país dirige o tipo de documento e a validação (doc 04).
  paisId               String
  pais                 Pais           @relation(fields: [paisId], references: [id])
  tipoDocumentoId      String?
  tipoDocumento        TipoDocumento? @relation(fields: [tipoDocumentoId], references: [id])
  documento            String? // número do documento
  documentoValido      Boolean        @default(false)
  documentoPaisEmissor String? // ISO 3166 (opcional) — permite documento estrangeiro
  nacionalidade        String? // ISO 3166
  segundaNacionalidade String? // ISO 3166 (opcional)

  // Contato — telefone/e-mail bloqueiam se inválidos (doc 04 §3).
  email              String?
  telefoneE164       String? // E.164 com DDI embutido (ex.: +50688887777). Máscara só na UI.
  whatsapp           Boolean @default(false) // o telefone principal é WhatsApp?
  aceitaComunicacoes Boolean @default(true) // opt-in de comunicações

  // Residência (doc 09 §Residência) — país pode diferir da nacionalidade (comum na AC).
  paisResidencia String? // ISO 3166
  cep            String?
  rua            String?
  numero         String?
  complemento    String?
  bairro         String?
  cidade         String?
  regiao         String? // Estado / Província / Departamento (nome varia por país)

  // Acadêmico (doc 09 §Acadêmico)
  escolaridade Escolaridade?
  idiomaNativo String?

  // Operacional (doc 09 §Operacional)
  fuso        String? // sobrescreve o fuso do país (envio de mensagens); default = país
  observacoes String?

  // Estado
  status   StatusAluno @default(ATIVO)
  criadoEm DateTime    @default(now())

  responsaveis     AlunoResponsavel[]
  matriculas       Matricula[]
  alocacoes        AlocacaoTurma[]
  movimentacoes    MovimentacaoAluno[]
  contatosWhatsApp ContatoWhatsApp[]

  @@index([telefoneE164])
}

model Responsavel {
  id           String  @id @default(cuid())
  nome         String
  parentesco   String?
  telefoneE164 String?
  email        String?

  alunos           AlunoResponsavel[]
  contatosWhatsApp ContatoWhatsApp[]

  @@index([telefoneE164])
}

enum PapelResponsavel {
  PEDAGOGICO
  FINANCEIRO
  EMERGENCIA // contato de emergência (doc 09 §Operacional) — nome/parentesco/telefone
}

model AlunoResponsavel {
  id            String           @id @default(cuid())
  alunoId       String
  aluno         Aluno            @relation(fields: [alunoId], references: [id])
  responsavelId String
  responsavel   Responsavel      @relation(fields: [responsavelId], references: [id])
  papel         PapelResponsavel @default(FINANCEIRO)
}

model AlocacaoTurma {
  id       String   @id @default(cuid())
  alunoId  String
  aluno    Aluno    @relation(fields: [alunoId], references: [id])
  turmaId  String
  turma    Turma    @relation(fields: [turmaId], references: [id])
  ativa    Boolean  @default(true)
  criadoEm DateTime @default(now())

  // Integridade (issue #1): no máx. UMA alocação ATIVA por aluno. Índice único PARCIAL
  // (só linhas ativa=true) — Prisma não modela WHERE em @@unique, então mora na migration
  // `integridade_alocacao_preco` (UNIQUE ... WHERE "ativa"). Histórico (ativa=false) é livre.
  @@index([alunoId])
  @@index([turmaId])
}

// MOVIMENTAÇÃO DO ALUNO — tabela TIPADA (decisão P6, doc 15).
// Mesmo princípio do financeiro: Evento = auditoria; tabela tipada = relatório/operação.
// Responde "quantos pausaram/encerraram este mês", "por que está nessa turma", etc.
// (turmaOrigem/Destino ficam como IDs simples — é um log; aluno/usuário têm relação.)
enum TipoMovimentacao {
  MATRICULA
  TROCA_TURMA
  PAUSA
  REATIVACAO
  ENCERRAMENTO
}

model MovimentacaoAluno {
  id             String           @id @default(cuid())
  alunoId        String
  aluno          Aluno            @relation(fields: [alunoId], references: [id])
  tipo           TipoMovimentacao
  turmaOrigemId  String?
  turmaDestinoId String?
  statusOrigem   StatusAluno?
  statusDestino  StatusAluno?
  motivo         String?
  observacao     String?
  usuarioId      String?
  usuario        Usuario?         @relation("AutorMovimentacoes", fields: [usuarioId], references: [id])
  criadoEm       DateTime         @default(now())

  @@index([alunoId])
  @@index([tipo])
  @@index([criadoEm])
}

// ============================================================
// COMERCIAL (LEAD)
// ============================================================

enum Temperatura {
  QUENTE
  MORNO
  FRIO
}

enum EtapaLead {
  NOVO
  EM_ATENDIMENTO
  QUALIFICADO
  EXPERIMENTAL_AGENDADA
  EXPERIMENTAL_REALIZADA
  PROPOSTA
  AGUARDANDO_MATRICULA
  MATRICULADO
  NO_SHOW
  PERDIDO
}

enum MotivoPerda {
  NAO_RESPONDEU
  PRECO
  TEMPO
  CONCORRENCIA
  INTERESSE
  LOCALIZACAO
  EMPRESA
  QUALIFICACAO
  OUTRO
}

model Lead {
  id             String      @id @default(cuid())
  codigo         String?     @unique // L-000001
  nome           String
  telefoneE164   String?
  paisId         String?
  pais           Pais?       @relation(fields: [paisId], references: [id])
  segmento       Segmento    @default(ADULTO)
  temperatura    Temperatura @default(MORNO)
  etapa          EtapaLead   @default(NOVO)
  b2b            Boolean     @default(false)
  vendedorDonoId String?
  vendedor       Usuario?    @relation("VendedorLeads", fields: [vendedorDonoId], references: [id])

  // Professor responsável pela experimental (Issue #13). FK opcional (NULL) =
  // sem atribuição: experimentais antigas/sem professor ficam sem escopo até
  // serem (re)atribuídas. Fonte de verdade do vínculo professor↔experimental;
  // o evento `ExperimentalAtribuida` é mantido apenas para auditoria.
  professorExperimentalId String?
  professorExperimental   Usuario? @relation("ProfessorExperimentais", fields: [professorExperimentalId], references: [id])

  // origem inteligente (hierarquia de anúncio: campanha/conjunto/anúncio/palavra). Só é
  // preenchida quando resolvida corretamente (form manual, ou Marketing API no futuro).
  origemCampanha String?
  origemConjunto String?
  origemAnuncio  String?
  origemPalavra  String?

  // Referral CRU do click-to-WhatsApp (doc 27 C1 · review PR #53): os campos da Meta têm
  // SEMÂNTICA PRÓPRIA e NÃO são a hierarquia de anúncio — `sourceType` é só `ad|post`,
  // `sourceId` é o id do anúncio/post, `headline` é o título, `ctwaClid` é o id do clique.
  // Guardados crus aqui; a resolução p/ campanha/conjunto exige a Marketing API (fora da C1).
  waReferralSourceType String?
  waReferralSourceId   String?
  waReferralHeadline   String?
  waReferralSourceUrl  String?
  waReferralCtwaClid   String?

  // resumo executivo (manual no V0, IA na Fase 1)
  interesse   String?
  objetivo    String?
  urgencia    String?
  orcamento   String?
  objecao     String?
  proximaAcao String?

  // datas que alimentam a fila da Home
  proximoFollowUp  DateTime?
  dataExperimental DateTime?
  dataProposta     DateTime?

  // Estado de CONFIRMAÇÃO da experimental (doc 27 C2 · gap 33 do doc 28): o lead respondeu
  // confirmando a presença (botão no oficial ou "SIM" no Baileys). O histórico de
  // reagendamento já vem dos eventos `ExperimentalAgendada` repetidos — não precisa coluna.
  experimentalConfirmadaEm DateTime?

  // B8 (doc 32): o lead pediu REAGENDAR — a cadência pré-experimental fica PAUSADA até a
  // ação humana (o vendedor remarcar limpa o campo em `agendarExperimental`). Sem estado
  // persistido, o tick seguinte re-enfileirava o próximo degrau por cima do pedido.
  aguardandoReagendamentoEm DateTime?

  // valor da oportunidade (Ficha do Lead — doc 09)
  valorPrevisto    Decimal? @db.Decimal(12, 2)
  planoPrevisto    String?
  comissaoPrevista Decimal? @db.Decimal(12, 2)

  motivoPerda    MotivoPerda?
  ultimaCobranca DateTime?
  criadoEm       DateTime     @default(now())

  matricula        Matricula?
  documentos       Documento[]
  contatosWhatsApp ContatoWhatsApp[]
  intencoesWhatsApp IntencaoMensagem[]
  sugestoesIA      SugestaoIA[]

  @@index([telefoneE164])
}

enum CategoriaDocumento {
  PROPOSTA
  CONTRATO
  COMPROVANTE
  TESTE_NIVEL
  OUTRO
}

// Documentos anexados ao lead (Propostas/Contratos/Comprovantes/Teste de nível — doc 09).
model Documento {
  id        String             @id @default(cuid())
  leadId    String
  lead      Lead               @relation(fields: [leadId], references: [id])
  categoria CategoriaDocumento
  nome      String
  url       String
  arquivado Boolean            @default(false) // soft-delete (doc 10 §6: ninguém apaga nada)
  criadoEm  DateTime           @default(now())

  @@index([leadId])
}

// ============================================================
// MATRÍCULA / FINANCEIRO
// ============================================================

enum StatusMatricula {
  RASCUNHO
  AGUARDANDO
  ATIVA
  ENCERRADA
  CANCELADA // encerramento precoce → estorno de comissão (ver docs/10)
}

model Matricula {
  id                     String          @id @default(cuid())
  alunoId                String
  aluno                  Aluno           @relation(fields: [alunoId], references: [id])
  leadId                 String?         @unique
  lead                   Lead?           @relation(fields: [leadId], references: [id])
  produtoId              String
  produto                Produto         @relation(fields: [produtoId], references: [id])
  paisId                 String
  pais                   Pais            @relation(fields: [paisId], references: [id])
  codigo                 String?         @unique // M-000001
  moeda                  String
  status                 StatusMatricula @default(RASCUNHO)
  diaVencimento          Int             @default(5)
  mesesPlano             Int             @default(12) // p/ gerar o cronograma na ativação
  // Gatilho de ativação (decisão P7, doc 15): ATIVA exige os três true.
  contratoOk             Boolean         @default(false)
  pagamentoTaxaOk        Boolean         @default(false)
  primeiraMensalidadeOk  Boolean         @default(false)
  // Exceção: Admin/Gerente pode ativar com pendência (registra o porquê em Evento).
  ativadaComPendencia    Boolean         @default(false)
  // Exceção de preço auditável (Issues #7/#22): matrícula criada SEM preço de
  // referência ATIVO para a combinação país × produto × tipo de cobrança, por
  // exceção justificada + aprovada. Exige justificativa e grava Evento
  // `MatriculaSemPrecoReferencia`. Permite operar países/produtos sem matriz de
  // preços fechada (doc 06 §Em aberto) sem perder a auditoria.
  precoReferenciaAusente Boolean         @default(false)
  justificativaSemPreco  String?
  // C4 (doc 27 §fechamento): quando o CONTRATO foi enviado ao cliente — âncora da régua
  // "contrato sem assinatura em 48h". Re-enviar atualiza (abre ocorrência nova da cadência).
  contratoEnviadoEm      DateTime?
  // Nível inicial + origem (doc 09 §Matrícula): de onde veio o nível do aluno.
  nivelInicialId         String?
  origemNivel            OrigemNivel?
  dataAvaliacaoNivel     DateTime?
  criadoEm               DateTime        @default(now())
  ativadaEm              DateTime?
  // Bloqueio de acesso à aula (régua de cobrança D+15, doc 24). Flag ortogonal ao status:
  // a matrícula segue ATIVA, só perde acesso. Exige aprovação humana (Gerente Com./Admin);
  // o enforcement técnico (barrar entrada na aula) é Fase 1+ — aqui grava-se a decisão.
  acessoBloqueado        Boolean         @default(false)
  bloqueadoEm            DateTime?

  cobrancas Cobranca[]
  comissoes Comissao[]
  ajustes   AjusteFinanceiro[]
}

enum OrigemNivel {
  AVALIACAO
  MANUAL
}

enum StatusCobranca {
  PENDENTE
  PAGO
  ATRASADO
  CANCELADA
}

enum FormaPagamento {
  TRANSFERENCIA
  GREENPAY
  DINHEIRO
  CARTAO
}

model Cobranca {
  id              String          @id @default(cuid())
  codigo          String?         @unique // C-000001
  matriculaId     String
  matricula       Matricula       @relation(fields: [matriculaId], references: [id])
  tipo            TipoCobranca
  competencia     String? // "2026-06" para mensalidades
  valorOriginal   Decimal         @db.Decimal(12, 2)
  valorNegociado  Decimal         @db.Decimal(12, 2)
  valorRecebido   Decimal?        @db.Decimal(12, 2)
  saldo           Decimal?        @db.Decimal(12, 2) // valorNegociado - valorRecebido
  moeda           String
  vencimento      DateTime
  status          StatusCobranca  @default(PENDENTE)
  pagoEm          DateTime?
  formaPagamento  FormaPagamento?
  // C4 (doc 27 §fechamento): link de pagamento enviado ao cliente. `linkEnviadoEm` é a
  // âncora da régua "link sem pagamento". Na Fase 2 o gateway gera o link; aqui pode ser
  // registrado manualmente (Pix copia-e-cola, link do provedor etc.).
  linkPagamento   String?
  linkEnviadoEm   DateTime?
  comprovanteUrl  String?
  comprovanteNome String?
  comentario      String?
  criadoEm        DateTime        @default(now())

  intencoesWhatsApp IntencaoMensagem[]
}

enum StatusComissao {
  PENDENTE
  APROVADA
  PAGA
  ESTORNADA
}

model Comissao {
  id                    String         @id @default(cuid())
  matriculaId           String
  matricula             Matricula      @relation(fields: [matriculaId], references: [id])
  vendedorId            String
  vendedor              Usuario        @relation(fields: [vendedorId], references: [id])
  percentual            Decimal        @db.Decimal(5, 2)
  valor                 Decimal        @db.Decimal(12, 2)
  moeda                 String
  status                StatusComissao @default(PENDENTE)
  dataPrevistaPagamento DateTime?
  pagaEm                DateTime?
  criadoEm              DateTime       @default(now())
}

// ============================================================
// APROVAÇÕES (engine genérica)
// ============================================================

enum TipoAprovacao {
  DESCONTO
  BOLSA
  ALTERACAO_VALOR
  PERDAO_DIVIDA
  COMISSAO_EXCEPCIONAL
}

enum StatusAprovacao {
  PENDENTE
  APROVADA
  REJEITADA
}

enum Vigencia {
  ESTA_COBRANCA
  PROXIMOS_MESES
  CONTRATO_INTEIRO
}

model Aprovacao {
  id            String          @id @default(cuid())
  tipo          TipoAprovacao
  status        StatusAprovacao @default(PENDENTE)
  solicitanteId String
  solicitante   Usuario         @relation("SolicitanteAprovacoes", fields: [solicitanteId], references: [id])
  aprovadorId   String?
  aprovador     Usuario?        @relation("AprovadorAprovacoes", fields: [aprovadorId], references: [id])
  alvoTipo      String // "Cobranca", "Comissao"...
  alvoId        String?
  payload       Json? // { de, para, percentual, ... }
  vigencia      Vigencia?
  motivo        String?
  impactoMensal Decimal?        @db.Decimal(12, 2)
  criadoEm      DateTime        @default(now())
  decididoEm    DateTime?
}

// ============================================================
// AJUSTE FINANCEIRO — tabela TIPADA (relatório). Evento cuida da auditoria.
// Responde: total de desconto concedido · desconto por vendedor / país / modalidade.
// ============================================================

enum TipoAjuste {
  DESCONTO
  BOLSA
  ALTERACAO_VALOR
  PERDAO
  RENEGOCIACAO
}

model AjusteFinanceiro {
  id            String     @id @default(cuid())
  matriculaId   String
  matricula     Matricula  @relation(fields: [matriculaId], references: [id])
  cobrancaId    String? // referência leve (opcional)
  tipo          TipoAjuste
  valorDe       Decimal    @db.Decimal(12, 2)
  valorPara     Decimal    @db.Decimal(12, 2)
  descontoValor Decimal    @db.Decimal(12, 2) // valorDe - valorPara
  descontoPct   Decimal?   @db.Decimal(5, 2)
  moeda         String
  vigencia      Vigencia?
  motivo        String
  autorId       String
  autor         Usuario    @relation("AutorAjustes", fields: [autorId], references: [id])
  aprovacaoId   String?
  // denormalizados p/ relatório fácil (group by):
  vendedorId    String?
  paisId        String?
  modalidadeId  String?
  criadoEm      DateTime   @default(now())

  @@index([vendedorId])
  @@index([paisId])
  @@index([modalidadeId])
  @@index([criadoEm])
}

// ============================================================
// CÂMBIO — cotações manuais p/ CONSOLIDAÇÃO gerencial (reporting-only, doc 04 §Câmbio).
// NUNCA toca a conta do aluno: cada cobrança fica na sua moeda. Pivô único = USD
// (`unidadesPorUsd` = quantas unidades da moeda equivalem a 1 USD; USD seria 1, não é gravado).
// Append-only por (moeda, vigenteEm): a leitura usa a cotação MAIS RECENTE por moeda, e o
// histórico permite reconstruir a taxa usada em cada relatório. Auditoria de "quem" no Evento.
// ============================================================

model TaxaCambio {
  id             String   @id @default(cuid())
  moeda          String // ISO 4217 (ex.: CRC, BRL). Alvo/origem de conversão; USD é o pivô.
  unidadesPorUsd Decimal  @db.Decimal(14, 6) // quantas unidades desta moeda equivalem a 1 USD (ex.: CRC ~ 512)
  vigenteEm      DateTime @default(now())
  criadoEm       DateTime @default(now())

  @@index([moeda, vigenteEm])
}

// ============================================================
// EVENTO — audit / event log append-only (ESPINHA DORSAL)
// ============================================================

model Evento {
  id           String   @id @default(cuid())
  tipo         String // LeadCriado, MatriculaAtivada, PagamentoRegistrado, AlunoPausado...
  agregadoTipo String // "Lead", "Matricula", "Aluno", "Cobranca"...
  agregadoId   String
  autorId      String?
  autor        Usuario? @relation("AutorEventos", fields: [autorId], references: [id])
  versao       Int      @default(1) // versão do formato do payload — versionamento salva vidas
  payload      Json? // { de, para, motivo, ... } — o antes→depois
  criadoEm     DateTime @default(now())

  @@index([agregadoTipo, agregadoId])
  @@index([tipo])
  @@index([criadoEm])
}

// ============================================================
// CONTADOR — gera os códigos legíveis (L-/A-/M-/C-/T-) sem corrida (transacional)
// ============================================================

model Contador {
  chave String @id // "lead", "aluno", "matricula", "cobranca", "turma"
  valor Int    @default(0)
}

// ============================================================
// WHATSAPP — canal bimotor (docs 26/29/30)
// Regra (doc 29 §3): estas são tabelas OPERACIONAIS (mutáveis, alto volume);
// o Evento grava só fatos de negócio (degrau cumprido, opt-out, ciclo de template).
// ============================================================

enum DriverWhatsApp {
  META_CLOUD
  BAILEYS
}

enum FinalidadeNumero {
  COBRANCA
  VENDAS
}

enum SessaoNumero {
  DESCONECTADO
  AGUARDANDO_QR
  CONECTADO
  CAIU
}

model NumeroWhatsApp {
  id           String           @id @default(cuid())
  telefoneE164 String           @unique
  rotulo       String // "Cobrança", "Vendas — Ana"
  driver       DriverWhatsApp
  finalidade   FinalidadeNumero
  providerRef  String? // META_CLOUD: phone_number_id · BAILEYS: nome da instância Evolution
  sessao       SessaoNumero     @default(DESCONECTADO) // relevante só p/ BAILEYS
  donoId       String? // dono da conversa = dono do número (doc 26 §Camada 3)
  dono         Usuario?         @relation("DonoNumerosWhatsApp", fields: [donoId], references: [id])
  ativo        Boolean          @default(true)
  criadoEm     DateTime         @default(now())

  conversas           ConversaWhatsApp[]
  mensagens           MensagemWhatsApp[]
  intencoes           IntencaoMensagem[]
  politicas           PoliticaRegua[]
  politicasComerciais PoliticaComercial[]
  configsGestao       ConfigComercial[]   @relation("NumeroGestao") // C5: remetente das msgs do gestor

  // providerRef identifica o número DENTRO do driver (phone_number_id da Meta ×
  // instância Evolution) — duplicado deixaria o roteamento dos webhooks ambíguo e a
  // mensagem cairia na conversa/dono errados (review PR #51 P2-6).
  @@unique([driver, providerRef])
}

model ContatoWhatsApp {
  id           String  @id @default(cuid())
  telefoneE164 String  @unique // 1ª unicidade de telefone do sistema (doc 29) — embrião da entidade Pessoa (comentário do topo)
  waId         String? @unique
  nomeExibicao String?

  // Vínculos opcionais — um contato pode ser responsável E lead ao mesmo tempo.
  alunoId       String?
  aluno         Aluno?       @relation(fields: [alunoId], references: [id])
  responsavelId String?
  responsavel   Responsavel? @relation(fields: [responsavelId], references: [id])
  leadId        String?
  lead          Lead?        @relation(fields: [leadId], references: [id])

  optOutEm DateTime? // LEI: opt-out sempre respeitado pelo despachante (doc 26/30 S10)
  criadoEm DateTime  @default(now())

  conversas ConversaWhatsApp[]
  intencoes IntencaoMensagem[]
}

model ConversaWhatsApp {
  id               String          @id @default(cuid())
  numeroId         String
  numero           NumeroWhatsApp  @relation(fields: [numeroId], references: [id])
  contatoId        String
  contato          ContatoWhatsApp @relation(fields: [contatoId], references: [id])
  ultimaMensagemEm DateTime?
  ultimoInboundEm  DateTime? // alimenta a lei do despachante + silêncio pós-inbound (S4)
  // "Tratar" o inbound (S4/E3): promessa/pagamento pela inbox ou "retomar régua" marcam
  // aqui; o despachante só aplica o silêncio quando ultimoInboundEm > inboundTratadoEm.
  inboundTratadoEm DateTime?
  // Captura comercial C1 (doc 27): CLAIM ATÔMICO do "1º inbound" — marcado uma única vez
  // por um updateMany condicional (where capturadaEm IS NULL). Dois inbounds concorrentes
  // do mesmo contato: só um vence o claim (lock de linha), então só um lead/saudação nasce
  // (review PR #53 P1 — o count===0 anterior não era atômico).
  capturadaEm      DateTime?
  naoLidas         Int             @default(0)
  criadoEm         DateTime        @default(now())

  mensagens MensagemWhatsApp[]

  @@unique([numeroId, contatoId]) // um contexto conversa por um número só (doc 26)
}

enum DirecaoMensagem {
  ENTRADA
  SAIDA
}

enum TipoMensagem {
  TEXTO
  IMAGEM
  AUDIO
  VIDEO
  DOCUMENTO
  OUTRO
}

enum StatusMensagem {
  NA_FILA
  ENVIADA
  ENTREGUE
  LIDA
  FALHOU
}

enum OrigemEnvio {
  GESTAO // C5 (doc 27): mensagens do sistema para a EQUIPE (alerta de SLA, relatório do gestor)
  HUMANO
  CRON
  LOTE
}

model MensagemWhatsApp {
  id         String           @id @default(cuid())
  conversaId String
  conversa   ConversaWhatsApp @relation(fields: [conversaId], references: [id])
  numeroId   String // denormalizado p/ dedupe por número
  numero     NumeroWhatsApp   @relation(fields: [numeroId], references: [id])

  direcao   DirecaoMensagem
  tipo      TipoMensagem    @default(TEXTO)
  corpo     String? // snapshot do texto renderizado (auditoria — S/gap 15)
  midiaPath String? // caminho no storage (binário: decisão E3)

  status            StatusMensagem    @default(NA_FILA)
  statusEm          DateTime?
  driver            DriverWhatsApp
  origem            OrigemEnvio? // só SAIDA
  providerMessageId String? // wamid/key.id do driver
  autorId           String?
  autor             Usuario?          @relation("AutorMensagensWhatsApp", fields: [autorId], references: [id])
  templateId        String?
  template          TemplateWhatsApp? @relation(fields: [templateId], references: [id])
  criadoEm          DateTime          @default(now())

  intencao IntencaoMensagem?

  @@unique([numeroId, providerMessageId]) // dedupe dos retries de webhook (S7)
  @@index([conversaId, criadoEm])
}

enum StatusIntencao {
  PENDENTE
  ENVIANDO // claim atômico do despachante — evita envio duplo sob concorrência (review PR #49)
  DESPACHADA
  CANCELADA
  FALHOU
  ADIADA
  SIMULADA
}

// OUTBOX (doc 26 §fila única): nenhuma automação envia direto — grava intenção;
// o despachante único aplica os guard-rails e entrega ao driver do número.
model IntencaoMensagem {
  id        String          @id @default(cuid())
  numeroId  String
  numero    NumeroWhatsApp  @relation(fields: [numeroId], references: [id])
  contatoId String
  contato   ContatoWhatsApp @relation(fields: [contatoId], references: [id])

  origem           OrigemEnvio
  status           StatusIntencao    @default(PENDENTE)
  tipo             TipoMensagem      @default(TEXTO) // mídia da inbox (E3): IMAGEM/AUDIO/DOCUMENTO
  midiaPath        String? // URL canônica /api/files/... do binário (pipeline único — doc 29 regra 10)
  corpoRenderizado String // snapshot no enfileiramento (S/gap 15); em mídia é a legenda
  variaveis        Json? // valores posicionais p/ template Meta (mesma renderização do corpo)
  templateId       String?
  template         TemplateWhatsApp? @relation(fields: [templateId], references: [id])

  // Vínculo de domínio — cobrança na E1; lead na E6 (fase doc 27).
  cobrancaId String?
  cobranca   Cobranca?      @relation(fields: [cobrancaId], references: [id])
  passo      String? // PassoRegua ("D-7"...) — validado no Zod
  politicaId String?
  politica   PoliticaRegua? @relation(fields: [politicaId], references: [id])

  // Régua COMERCIAL (doc 27 C1 §Tese): lead-novo e demais cadências. Mesmo outbox/
  // despachante da cobrança; o vínculo de domínio é o Lead + o passo da cadência.
  leadId             String?
  lead               Lead?             @relation(fields: [leadId], references: [id])
  passoComercial     String? // passo da cadência comercial ("+30min"...) — idempotência
  // OCORRÊNCIA da cadência (review PR #56): a âncora em ISO. É o que separa um CICLO do
  // outro — experimental reagendada, segundo no-show. Sem ela a idempotência é eterna por
  // lead e a cadência nova nasce com os passos do ciclo anterior já cumpridos.
  ocorrenciaComercial String?
  politicaComercialId String?
  politicaComercial  PoliticaComercial? @relation(fields: [politicaComercialId], references: [id])

  // Classe REATIVA (doc 27 §regras transversais · gap C20): resposta automática a um
  // inbound (saudação) — isenta de janela/teto/silêncio (uma saudação "em segundos" não
  // pode esperar o horário comercial), mas respeita opt-out/kill switch/shadow.
  reativa Boolean @default(false)

  criadaEm        DateTime          @default(now()) // lei do despachante compara com ultimoInboundEm
  atualizadoEm    DateTime          @updatedAt // instante da última transição — saúde mede FALHOU por aqui (PR #52)
  despacharAposEm DateTime? // ADIADA (teto/janela) re-tenta depois daqui
  // B3 (doc 32): VALIDADE do disparo — intenção pré-evento (lembrete -24h/-2h) não pode
  // sair depois da aula, nem um degrau atrasado além da tolerância. O despachante CANCELA
  // (nunca envia) quando `agora > validaAte`, inclusive itens ADIADOS por janela/silêncio/
  // kill switch. NULL = sem validade (comportamento de backlog da cobrança).
  validaAte       DateTime?
  despachadaEm    DateTime?
  motivoFalha     String? // sem_destino, driver, opt_out... — estampado na fila humana
  mensagemId      String?           @unique
  mensagem        MensagemWhatsApp? @relation(fields: [mensagemId], references: [id])
  autorId         String? // quem enfileirou (HUMANO/LOTE); null = cron
  autor           Usuario?          @relation("AutorIntencoesWhatsApp", fields: [autorId], references: [id])

  @@unique([cobrancaId, passo]) // idempotência por degrau EM BANCO (doc 29 regra 8)
  // Cadência comercial: a idempotência inclui a POLÍTICA (review PR #55) e a OCORRÊNCIA
  // (review PR #56). "Um motor, N políticas" só se sustenta se cadências distintas puderem
  // compartilhar nomes de passo sem colidir no mesmo lead (+30min/+3d/+7d aparecem em
  // lead-novo e no-show); a ocorrência (âncora em ISO — horário da aula, 1º inbound) separa
  // um CICLO do outro no mesmo lead/cadência (um 2º no-show não nasce "feito"). É um índice
  // UNIQUE PARCIAL (WHERE as colunas comerciais IS NOT NULL), no padrão do repo para
  // unicidade condicional (cf. integridade_alocacao_preco): mora na migration
  // `ocorrencia_cadencia_comercial` (Prisma não modela WHERE em @@unique) e o predicado
  // mantém as intenções de COBRANÇA (essas colunas nulas) fora da constraint. O mesmo índice
  // cobre o lookup do enfileirador (findFirst com as quatro colunas presentes).
  @@index([status, despacharAposEm])
}

enum StatusTemplate {
  RASCUNHO
  EM_REVISAO
  APROVADO
  REJEITADO
}

// Entidade única com ciclo duplo (doc 26 §Camada 2): statusMeta só importa quando o
// template roda em número META_CLOUD; em BAILEYS todo template vale no ato (texto livre).
model TemplateWhatsApp {
  id             String         @id @default(cuid())
  nome           String         @unique // amigavel, dados, vencida, firme
  corpo          String // com variáveis {nome} {valor} {vencimento} {link}
  idioma         String         @default("es") // casar com Pais.idioma (gap 11)
  categoria      String         @default("utility")
  statusMeta     StatusTemplate @default(RASCUNHO)
  metaTemplateId String?
  criadoEm       DateTime       @default(now())
  atualizadoEm   DateTime       @updatedAt

  degraus            DegrauPolitica[]
  degrausComerciais  DegrauComercial[]
  mensagens          MensagemWhatsApp[]
  intencoes          IntencaoMensagem[]
}

enum ModoDegrau {
  AUTOMATICO
  MANUAL
  LOTE
}

enum EstadoPolitica {
  DESLIGADA
  SHADOW
  ATIVA
}

// Política como DADO (doc 26): a const REGUA vira default de fábrica (seed).
// LEIS fora da config (código): D+15 nunca AUTOMATICO; régua automática exige driver
// oficial (S1); opt-out sempre respeitado; despachante nunca fala por cima de conversa viva.
model PoliticaRegua {
  id                      String          @id @default(cuid())
  nome                    String          @unique
  escopo                  String          @default("COBRANCA")
  estado                  EstadoPolitica  @default(DESLIGADA) // toda automação nasce desligada (doc 27)
  janelaInicio            Int             @default(9) // hora local do CONTATO (S3: Aluno.fuso ?? Pais.fuso)
  janelaFim               Int             @default(20)
  diasSemana              Int[]           @default([1, 2, 3, 4, 5]) // 0=domingo
  tetoPorContatoDia       Int             @default(2) // S5
  silencioPosInboundHoras Int             @default(72) // S4
  killSwitch              Boolean         @default(false)
  numeroRemetenteId       String?
  numeroRemetente         NumeroWhatsApp? @relation(fields: [numeroRemetenteId], references: [id])
  criadoEm                DateTime        @default(now())
  atualizadoEm            DateTime        @updatedAt

  degraus   DegrauPolitica[]
  intencoes IntencaoMensagem[]
}

model DegrauPolitica {
  id         String            @id @default(cuid())
  politicaId String
  politica   PoliticaRegua     @relation(fields: [politicaId], references: [id])
  passo      String // "D-7"..."D+15"
  offsetDias Int
  tipo       String // lembrar | cobrar | bloquear
  rotulo     String
  modo       ModoDegrau        @default(MANUAL)
  ativo      Boolean           @default(true)
  templateId String?
  template   TemplateWhatsApp? @relation(fields: [templateId], references: [id])

  @@unique([politicaId, passo])
}

// ============================================================
// COMERCIAL — fase pós-V1 (doc 27). C1 "captura + velocidade": auto-lead no 1º inbound
// do número de vendas + saudação automática (texto fixo, reativa). Config como DADO,
// singleton (id fixo "comercial"). Regra de ouro (doc 27): TODA automação nasce DESLIGADA.
// A régua "lead novo sem resposta" e as demais políticas comerciais (C1 cadência + C2)
// entram na fatia seguinte, no mesmo motor generalizado por âncora.
// ============================================================

// Régua COMERCIAL como DADO (doc 27 §Tese: "um motor de réguas, N políticas"). A cadência
// "lead novo sem resposta" (D0=saudação já na C1; +30min·+4h·+24h·+3d·+7d — doc 08) é a
// 1ª política; no-show/proposta/nutrição entram no MESMO modelo. Nasce DESLIGADA (regra de
// ouro do doc 27). Guard-rails próprios (janela/dias/teto/silêncio) — o despachante os aplica
// como na cobrança. A ORDEM dos passos é lei de código (regua.ts) — aqui só offset/ativo.
model PoliticaComercial {
  id                      String            @id @default(cuid())
  chave                   String            @unique // "LEAD_NOVO_SEM_RESPOSTA" (âncora/cenário)
  nome                    String
  estado                  EstadoPolitica    @default(DESLIGADA)
  janelaInicio            Int               @default(9) // hora local do contato
  janelaFim               Int               @default(20)
  diasSemana              Int[]             @default([1, 2, 3, 4, 5])
  tetoPorContatoDia       Int               @default(2)
  silencioPosInboundHoras Int               @default(72)
  numeroRemetenteId       String?
  numeroRemetente         NumeroWhatsApp?   @relation(fields: [numeroRemetenteId], references: [id])

  // B1 (doc 32): COHORT REAL do piloto. Em modo piloto (default — regra de ouro), o cron
  // só enfileira para leads da allowlist explícita; lista vazia = ninguém. Desligar o modo
  // piloto é o go-live geral da cadência — decisão explícita do gerente, nunca acidente.
  modoPiloto    Boolean  @default(true)
  pilotoLeadIds String[] @default([])

  criadoEm                DateTime          @default(now())
  atualizadoEm            DateTime          @updatedAt

  degraus   DegrauComercial[]
  intencoes IntencaoMensagem[]
}

model DegrauComercial {
  id           String            @id @default(cuid())
  politicaId   String
  politica     PoliticaComercial @relation(fields: [politicaId], references: [id])
  passo        String // "+30min", "+4h", "+24h", "+3d", "+7d"
  offsetMinutos Int // minutos após a âncora (1º inbound do lead)
  rotulo       String
  ativo        Boolean           @default(true)
  // B3/B4 (doc 32): tolerância MÁXIMA de atraso do degrau, em minutos — além dela o
  // disparo perde sentido e a intenção é cancelada via `validaAte`. NULL = sem limite.
  toleranciaMinutos Int?
  templateId   String?
  template     TemplateWhatsApp? @relation(fields: [templateId], references: [id])

  @@unique([politicaId, passo])
}

model ConfigComercial {
  id            String   @id @default("comercial") // singleton
  // Auto-criar lead no 1º inbound de um número VENDAS sem vínculo (gap 17 dedupe na ação).
  autoLeadAtivo Boolean  @default(false)
  // Saudação automática (resposta reativa, "em segundos") ao 1º inbound de um lead novo.
  // Shadow PRÓPRIO (doc 27 §regra de ouro): DESLIGADA · SHADOW (registra o que TERIA sido
  // enviado, sem enviar) · ATIVA. Reusa o enum das políticas de cobrança.
  saudacaoEstado EstadoPolitica @default(DESLIGADA)
  saudacaoTexto  String         @default("Olá! Recebemos sua mensagem e já retornamos. 😊")
  // B9 (doc 32): tolerância (minutos após o horário da aula) para o professor registrar o
  // check-in da experimental. Vencida a tolerância sem check-in: evento
  // `ExperimentalCheckInVencido` + alerta nas Homes (professor e gerente). Sem o check-in
  // a recuperação de no-show (C2) nunca dispara — o alerta é o que fecha esse ciclo.
  checkInToleranciaMinutos Int @default(30)
  // C3 (doc 27): IA copiloto SÓ-LEITURA — resume, sugere temperatura/segmento/etapa; um
  // humano aceita/corrige/descarta. A IA NUNCA fala com o cliente e nasce DESLIGADA.
  copilotoAtivo            Boolean @default(false)
  // Gatilho "conversa quieta": ~N min após o último inbound sem resposta do vendedor.
  copilotoQuietudeMinutos  Int     @default(10)
  // C4 (doc 27): matrícula AUTOMÁTICA — contrato OK + taxa PAGA numa matrícula AGUARDANDO
  // ativam sozinhos (cronograma + comissão + lead MATRICULADO). Nasce DESLIGADA; a turma
  // segue híbrida (o sistema sugere, o consultor confirma — nunca aloca sozinho).
  matriculaAutomaticaAtiva Boolean @default(false)
  // C5 (doc 27): GESTÃO — alerta de SLA + relatório diário no WhatsApp do gestor.
  // Shadow próprio (DESLIGADA/SHADOW/ATIVA — nasce DESLIGADA); mensagens saem pela MESMA
  // outbox/despachante com origem GESTAO (isentas de janela/teto/silêncio: são para a
  // equipe, não para clientes; o kill switch global congela também).
  gestaoEstado        EstadoPolitica @default(DESLIGADA)
  gestaoTelefoneE164  String? // WhatsApp do gestor (destino)
  gestaoNumeroId      String? // número remetente (vendas)
  gestaoNumero        NumeroWhatsApp? @relation("NumeroGestao", fields: [gestaoNumeroId], references: [id])
  gestaoSlaMinutos    Int            @default(30) // lead NOVO parado além disto = alerta
  gestaoRelatorioHora Int            @default(19) // hora (do servidor) do relatório diário
  criadoEm       DateTime       @default(now())
  atualizadoEm   DateTime       @updatedAt
}

// ============================================================
// C3 — IA COPILOTO (doc 27): sugestões SÓ-LEITURA sobre o lead. Cada análise (lote) gera
// até uma sugestão POR TIPO; o vendedor decide uma a uma (aceitar/corrigir/descartar) —
// é essa decisão que alimenta a MÉTRICA-GATE (taxa de aceitação por tipo), a condição
// para qualquer auto-aplicação futura. A IA nunca envia mensagem (lei do doc 27).
// ============================================================

enum TipoSugestaoIA {
  RESUMO // os 6 campos do resumo executivo (doc 08)
  TEMPERATURA
  SEGMENTO
  ETAPA // só destinos MANUAIS que a máquina de estados aceita (doc 29 regra 7)
}

enum StatusSugestaoIA {
  PENDENTE
  ACEITA
  CORRIGIDA // aceita com edição — conta separado na métrica
  DESCARTADA
  EXPIRADA // superada por um lote mais novo antes de decisão humana
}

enum GatilhoSugestaoIA {
  QUIETUDE // conversa quieta ~10min após o último inbound
  MUDANCA_ETAPA
  SOB_DEMANDA
}

model SugestaoIA {
  id      String            @id @default(cuid())
  leadId  String
  lead    Lead              @relation(fields: [leadId], references: [id])
  loteId  String // agrupa as sugestões geradas numa MESMA análise
  tipo    TipoSugestaoIA
  status  StatusSugestaoIA  @default(PENDENTE)
  gatilho GatilhoSugestaoIA
  payload Json // { campos sugeridos } — shape por tipo (ver ia/tipos.ts)
  justificativa String? // por que a IA sugeriu (exibida ao vendedor)
  modelo  String // "simulado" ou o id do modelo LLM
  // Idempotência do gatilho QUIETUDE: o inbound que ancorou a análise.
  ancoraInbound DateTime?

  criadoEm      DateTime  @default(now())
  decididaEm    DateTime?
  decididaPorId String?
  decididaPor   Usuario?  @relation("DecisorSugestoesIA", fields: [decididaPorId], references: [id])

  @@index([leadId, status])
  @@index([status, criadoEm])
}
