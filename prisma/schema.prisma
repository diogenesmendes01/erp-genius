  professor Usuario? @relation("DocenteEncontroAgenda", fields: [professorId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  preparadorId String
  preparador Usuario @relation("PreparadorEncontroAgenda", fields: [preparadorId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  inicio DateTime
