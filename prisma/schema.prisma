  motivo String
  chaveIdempotencia String
  entradaHash String
  criadoEm DateTime @default(now())
  @@unique([preparadorId, chaveIdempotencia], map: "encontro_agenda_chave_key")
  @@index([professorId, inicio, fim])
  @@index([turmaId, inicio])
  @@index([matriculaId, inicio])
  agendaSegundaChamada AgendaSegundaChamada?
  propostaAgendaSegundaChamadaId String? @unique
  propostaAgendaSegundaChamada PropostaAgendaSegundaChamada? @relation(fields:[propostaAgendaSegundaChamadaId],references:[id],onDelete:Restrict)
