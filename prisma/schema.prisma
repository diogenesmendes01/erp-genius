// ERP Genius — schema modelado em EVENTOS + estado (não em telas).
// Espinha dorsal: tabela `Evento` (audit/event log append-only).
// Regra: Evento = auditoria; tabelas tipadas (ex.: AjusteFinanceiro) = relatório.
// Evolução futura (NÃO V0): Papel enum[] -> tabela UsuarioPapel (escopo por país);
//   unificar Lead/Aluno/Responsavel sob uma entidade Pessoa/Contato.
// Ver docs/02-arquitetura.md e docs/09-fase0-telas.md.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ConfiguracaoOperacional {
  // Campos novos são opcionais no banco para não inventar prazo para a escola
  // existente. O serviço do portal exige todos antes de criar sessão ou token.
  prazoSessaoPortalAlunoMinutos          Int?
  prazoConvitePortalAlunoMinutos         Int?
  prazoRecuperacaoPortalAlunoMinutos     Int?
  prazoValidacaoEmailPortalAlunoMinutos  Int?
  prazoPrimeiraEntregaReposicaoMinutos Int?
  prazoRespostaCorrecaoReposicaoMinutos Int?
  prazoRegularizacaoDiarioMinutos Int?
  intervaloLembreteDiarioMinutos Int?
  // Canal institucional de avisos de agenda: a escola o escolhe de forma
  // explícita; nunca é inferido do número comercial ou financeiro.
  numeroAvisosAgendaId String? @unique
  numeroAvisosAgenda NumeroWhatsApp? @relation("NumeroAvisosAgenda", fields: [numeroAvisosAgendaId], references: [id], onDelete: Restrict)
  templateAvisosAgendaId String? @unique
  templateAvisosAgenda TemplateWhatsApp? @relation("TemplateAvisosAgenda", fields: [templateAvisosAgendaId], references: [id], onDelete: Restrict)

  id String @id @default("escola")
  fusoInstitucional String?
  exigirPrimeiraMensalidade Boolean @default(false)
  prazoConferenciaHoras Int @default(48)
  prazoReservaMinutos Int?
  alteradaPorId String?
  atualizadoEm DateTime @updatedAt
}

enum StatusMudancaAcademica {
  PENDENTE
  APROVADA
  REJEITADA
  EXECUTADA
  CANCELADA
}

// Q154: o encaminhamento de regularização preserva a pendência; somente as
// duas ações terminais retiram o caso da revisão aberta.
enum AcaoResolucaoRevisaoProgressao {
  REGISTRAR_CANCELAMENTO
  RECONFIRMAR_EXECUTADA
  ENCAMINHAR_REGULARIZACAO
}

// A aprovação pedagógica autoriza a execução posterior; não altera a alocação sozinha.
model SolicitacaoMudancaAcademica {
  id String @id @default(cuid())
  matriculaId String?
  matricula Matricula? @relation(fields: [matriculaId, alunoId], references: [id, alunoId], onDelete: Restrict, onUpdate: NoAction)
  // Legado pode não ter fechamento; progressão nova exige esta referência na
  // aprovação e execução, preservando o hash da versão então conferida.
  fechamentoAcademicoId String?
  fechamentoAcademico FechamentoAcademico? @relation(fields: [fechamentoAcademicoId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  fechamentoEstadoHash String?
  alunoId String
  aluno Aluno @relation(fields: [alunoId], references: [id], onDelete: Restrict)
  alocacaoOrigemId String
  alocacaoOrigem AlocacaoTurma @relation(fields: [alocacaoOrigemId], references: [id], onDelete: Restrict)
  turmaOrigemId String
  turmaOrigem Turma @relation("OrigemMudancaAcademica", fields: [turmaOrigemId], references: [id], onDelete: Restrict)
  turmaDestinoId String
  turmaDestino Turma @relation("DestinoMudancaAcademica", fields: [turmaDestinoId], references: [id], onDelete: Restrict)
  motivo String
  horarioCompativel Boolean
  snapshot Json
  status StatusMudancaAcademica @default(PENDENTE)
  solicitanteId String
  solicitante Usuario @relation("SolicitanteMudancaAcademica", fields: [solicitanteId], references: [id], onDelete: Restrict)
  aprovadorId String?
  aprovador Usuario? @relation("AprovadorMudancaAcademica", fields: [aprovadorId], references: [id], onDelete: Restrict)
  motivoDecisao String?
  justificativaDispensaParecer String?
  decididoEm DateTime?
  executorId String?
  executor Usuario? @relation("ExecutorMudancaAcademica", fields: [executorId], references: [id], onDelete: Restrict)
  motivoExecucao String?
  executadoEm DateTime?
  canceladorId String?
  cancelador Usuario? @relation("CanceladorMudancaAcademica", fields: [canceladorId], references: [id], onDelete: Restrict)
  motivoCancelamento String?
  canceladoEm DateTime?
  movimentacaoId String? @unique
  movimentacao MovimentacaoAluno? @relation(fields: [movimentacaoId], references: [id], onDelete: Restrict)
  criadoEm DateTime @default(now())
  pareceres ParecerMudancaAcademica[]
  casosRevisaoProgressao CasoRevisaoProgressao[]
  propostasResolucaoRevisaoProgressao PropostaResolucaoRevisaoProgressao[]

  @@index([alunoId, criadoEm])
  @@index([status, criadoEm])
  @@index([turmaOrigemId, status])
  @@index([fechamentoAcademicoId])
}

model ParecerMudancaAcademica {
  id String @id @default(cuid())
  solicitacaoId String
  solicitacao SolicitacaoMudancaAcademica @relation(fields: [solicitacaoId], references: [id], onDelete: Restrict)
  autorId String
  autor Usuario @relation(fields: [autorId], references: [id], onDelete: Restrict)
  conteudo String
  criadoEm DateTime @default(now())

  @@index([solicitacaoId, criadoEm])
}

enum OpcaoRetomada {
  MANTER_VENCIMENTOS
  REPROGRAMAR_PARCELAS
}

// A proposta não altera calendário nem estado do aluno antes da aprovação independente.
model PropostaRetomada {
  id String @id @default(cuid())
  alunoId String
  aluno Aluno @relation(fields: [alunoId], references: [id], onDelete: Restrict)
  pausaId String
  pausa MovimentacaoAluno @relation(fields: [pausaId], references: [id], onDelete: Restrict)
  opcao OpcaoRetomada
  status StatusAprovacao @default(PENDENTE)
  motivo String
  solicitanteId String
  solicitante Usuario @relation("SolicitanteRetomada", fields: [solicitanteId], references: [id], onDelete: Restrict)
  aprovadorId String?
  aprovador Usuario? @relation("AprovadorRetomada", fields: [aprovadorId], references: [id], onDelete: Restrict)
  snapshot Json
  criadoEm DateTime @default(now())
  decididoEm DateTime?
  motivoDecisao String?
  @@index([alunoId, criadoEm])
  @@index([status, criadoEm])
}

enum StatusSolicitacaoAcessoAulas {
  PENDENTE
  APROVADA
  REJEITADA
}

model SolicitacaoAcessoAulas {
  id String @id @default(cuid())
  matriculaId String
  matricula Matricula @relation(fields: [matriculaId], references: [id], onDelete: Restrict)
  bloquear Boolean
  motivo String
  solicitanteId String
  solicitante Usuario @relation("SolicitanteAcessoAulas", fields: [solicitanteId], references: [id], onDelete: Restrict)
  aprovadorId String?
  aprovador Usuario? @relation("AprovadorAcessoAulas", fields: [aprovadorId], references: [id], onDelete: Restrict)
  status StatusSolicitacaoAcessoAulas @default(PENDENTE)
  versaoMatricula Int
  motivoDecisao String?
  criadoEm DateTime @default(now())
  decididoEm DateTime?
  @@index([matriculaId, status])
}

model RegistroUpload {
  categoriaDocumento CategoriaDocumento?
  id String @id @default(cuid())
  url String @unique
  autorId String
  autor Usuario @relation(fields: [autorId], references: [id], onDelete: Restrict)
  nome String
  mime String
  tamanho Int
  criadoEm DateTime @default(now())
  leadId String?
  alunoId String?
  cobrancaId String?
  matriculaId String?
}

model VinculoDocente {
  id String @id @default(cuid())
  turmaId String
  turma Turma @relation(fields: [turmaId], references: [id], onDelete: Restrict)
  professorId String
  professor Usuario @relation(fields: [professorId], references: [id], onDelete: Restrict)
  inicio DateTime
  fim DateTime?
  @@index([turmaId, professorId, inicio])
}

model AulaDiario {
  encontroId String? @unique
  encontro EncontroAgenda? @relation(fields: [encontroId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  propostasCorrecaoAula PropostaCorrecaoAula[] @relation("DiarioPropostaCorrecaoAula")
  id String @id @default(cuid())
  turmaId String?
  turma Turma? @relation(fields: [turmaId], references: [id], onDelete: Restrict)
  professorId String
  professor Usuario @relation(fields: [professorId], references: [id], onDelete: Restrict)
  ocorridaEm DateTime
  conteudo String
  criadoEm DateTime @default(now())
  atualizadoEm DateTime @updatedAt
  registros RegistroAulaAluno[]
  @@index([professorId, ocorridaEm])
}

enum ParticipacaoAula {
  PRESENTE
  FALTA
  IMPEDIDO_POR_RESTRICAO
}

model RegistroAulaAluno {
  matriculaId String?
  matricula Matricula? @relation(fields: [matriculaId, alunoId], references: [id, alunoId], onDelete: Restrict, onUpdate: NoAction, map: "registro_aula_contrato_fkey")
  participacao ParticipacaoAula?
  id String @id @default(cuid())
  aulaId String
  aula AulaDiario @relation(fields: [aulaId], references: [id], onDelete: Restrict)
  alunoId String
  aluno Aluno @relation(fields: [alunoId], references: [id], onDelete: Restrict)
  nomeAluno String
  presente Boolean?
  observacao String?
  @@unique([aulaId, alunoId])
}

enum StatusCorrecaoCadastro {
  PENDENTE
  CONCLUIDA
  REJEITADA
}

model SolicitacaoCorrecaoCadastro {
  id String @id @default(cuid())
  matriculaId String
  matricula Matricula @relation(fields: [matriculaId], references: [id], onDelete: Restrict)
  campo String
  valorProposto String?
  motivo String
  autorId String
  responsavelId String?
  status StatusCorrecaoCadastro @default(PENDENTE)
  motivoResolucao String?
  criadoEm DateTime @default(now())
  resolvidaEm DateTime?
  @@index([matriculaId, status])
}

model CoberturaCarteira {
  id String @id @default(cuid())
  titularId String
  titular Usuario @relation("TitularCobertura", fields: [titularId], references: [id], onDelete: Restrict)
  substitutoId String
  substituto Usuario @relation("SubstitutoCobertura", fields: [substitutoId], references: [id], onDelete: Restrict)
  concedenteId String
  concedente Usuario @relation("ConcedenteCobertura", fields: [concedenteId], references: [id], onDelete: Restrict)
  inicio DateTime
  fim DateTime
  revogadaEm DateTime?
  motivo String
  criadoEm DateTime @default(now())
  @@index([substitutoId, fim])
  @@index([titularId])
}

enum StatusPagamentoInformado {
  A_CONFERIR
  CONFIRMADO
  REJEITADO
}

model PagamentoInformado {
  suspenderLembretesAte DateTime?
  hashDados String?
  id String @id @default(cuid())
  chaveIdempotencia String @unique
  cobrancaId String
  cobranca Cobranca @relation(fields: [cobrancaId], references: [id], onDelete: Restrict)
  autorId String
  conferenteId String?
  status StatusPagamentoInformado @default(A_CONFERIR)
  valor Decimal @db.Decimal(12, 2)
  moeda String
  forma FormaPagamento
  dataPagamento DateTime
  comprovanteUrl String?
  comprovanteNome String?
  comentario String?
  permitirExcedente Boolean @default(false)
  versao Int @default(1)
  criadoEm DateTime @default(now())
  conferidoEm DateTime?
  motivoConferencia String?
  recebimento Recebimento?
  @@index([cobrancaId, status])
}

model Recebimento {
  hashDados String?
  id String @id @default(cuid())
  chaveIdempotencia String @unique
  cobrancaId String
  cobranca Cobranca @relation(fields: [cobrancaId], references: [id], onDelete: Restrict)
  informeId String? @unique
  informe PagamentoInformado? @relation(fields: [informeId], references: [id], onDelete: Restrict)
  autorId String
  valor Decimal @db.Decimal(12, 2)
  moeda String
  forma FormaPagamento
  dataPagamento DateTime
  criadoEm DateTime @default(now())
  @@index([dataPagamento])
  @@index([cobrancaId])
}

enum TipoComissao {
  PERCENTUAL
  VALOR_FIXO
}

model PoliticaComissao {
  id String @id @default(cuid())
  paisId String
  pais Pais @relation(fields: [paisId], references: [id], onDelete: Restrict)
  produtoId String
  produto Produto @relation(fields: [produtoId], references: [id], onDelete: Restrict)
  versao Int
  tipo TipoComissao
  base String @default("TAXA_MATRICULA")
  percentual Decimal? @db.Decimal(5, 2)
  valorFixo Decimal? @db.Decimal(12, 2)
  moeda String
  vigenteEm DateTime
  encerraEm DateTime?
  criadaPorId String
  criadoEm DateTime @default(now())
  comissoes Comissao[]
  @@unique([paisId, produtoId, versao])
  @@index([paisId, produtoId, vigenteEm])
}

enum FinalidadeAtendimentoWhatsApp {
  COMERCIAL
  FINANCEIRO
  SECRETARIA
  PEDAGOGICO
}

model AtendimentoWhatsApp {
  id String @id @default(cuid())
  conversaId String
  conversa ConversaWhatsApp @relation(fields: [conversaId], references: [id], onDelete: Restrict)
  contextoChave String
  finalidade FinalidadeAtendimentoWhatsApp
  responsavelId String?
  responsavel Usuario? @relation("ResponsavelAtendimentoWhatsApp", fields: [responsavelId], references: [id], onDelete: SetNull)
  leadId String?
  lead Lead? @relation(fields: [leadId], references: [id], onDelete: Restrict)
  alunoId String?
  aluno Aluno? @relation(fields: [alunoId], references: [id], onDelete: Restrict)
  matriculaId String?
  matricula Matricula? @relation(fields: [matriculaId, alunoId], references: [id, alunoId], onDelete: Restrict, onUpdate: Restrict)
  turmaId String?
  turma Turma? @relation(fields: [turmaId], references: [id], onDelete: Restrict)
  criadoEm DateTime @default(now())
  encerradoEm DateTime?
  ultimaMensagemEm DateTime?
  ultimoInboundEm DateTime?
  inboundTratadoEm DateTime?
  naoLidas Int @default(0)
  mensagens MensagemWhatsApp[]
  intencoes IntencaoMensagem[]
  participantes ParticipanteAtendimentoWhatsApp[]
  @@unique([conversaId, contextoChave])
  @@index([leadId])
  @@index([alunoId])
  @@index([matriculaId])
}

model ParticipanteAtendimentoWhatsApp {
  id String @id @default(cuid())
  atendimentoId String
  atendimento AtendimentoWhatsApp @relation(fields: [atendimentoId], references: [id], onDelete: Restrict)
  usuarioId String
  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Restrict)
  concedenteId String
  inicio DateTime
  fim DateTime
  revogadoEm DateTime?
  podeEnviar Boolean @default(false)
  motivo String
  @@index([atendimentoId, usuarioId, fim])
}

